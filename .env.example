PUBLIC_SPARK_APP_NAME="Karyra Spark"
PUBLIC_SPARK_MODE="production"
PUBLIC_SPARK_APP_URL="/"
PUBLIC_SPARK_API_URL="/api"
PUBLIC_SPARK_HUB_URL="/hub"

# Admin is fail-closed. Set all three values only in the private runtime environment.
# Never use PUBLIC_ prefixes for admin credentials or session secrets.
KARYRA_ADMIN_ENABLED="false"
KARYRA_ADMIN_PASSWORD=""
KARYRA_ADMIN_SESSION_SECRET=""

# Optional read-only Starknet RPC health check. The URL is never returned to the browser.
KARYRA_STARKNET_RPC_URL=""

# For local development, copy this file to .env and set private machine-specific URLs there.
# Keep public examples production-safe so preview/live builds never fall back to a developer machine.