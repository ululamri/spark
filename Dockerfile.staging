FROM node:22-alpine AS builder

WORKDIR /app

RUN corepack enable

COPY package.json pnpm-lock.yaml* ./
RUN if [ -f pnpm-lock.yaml ]; then pnpm install --frozen-lockfile; else pnpm install; fi

COPY . .

ARG PUBLIC_API_BASE=""
ARG PUBLIC_SPARK_API_BASE=""
ARG PUBLIC_SPARK_HUB_URL="/hub/"
ARG PUBLIC_SPARK_APP_URL=""
ARG PUBLIC_SPARK_MODE="production"
ARG ORIGIN=""

ENV PUBLIC_API_BASE=${PUBLIC_API_BASE}
ENV PUBLIC_SPARK_API_BASE=${PUBLIC_SPARK_API_BASE}
ENV PUBLIC_SPARK_HUB_URL=${PUBLIC_SPARK_HUB_URL}
ENV PUBLIC_SPARK_APP_URL=${PUBLIC_SPARK_APP_URL}
ENV PUBLIC_SPARK_MODE=${PUBLIC_SPARK_MODE}
ENV ORIGIN=${ORIGIN}

RUN pnpm run build
RUN pnpm prune --prod

FROM node:22-alpine AS runtime

WORKDIR /app

RUN corepack enable

ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=4173

COPY --from=builder /app/build ./build
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/node_modules ./node_modules

EXPOSE 4173

CMD ["node", "build"]
