/* Pass 35B — Foundation UI Consolidation
   Realfix: this file is the active foundation layer. No new CSS import is added.
   It replaces the earlier 35B file so Home, brand, drawer, dashboard, footer,
   and mobile density are controlled from one place. */

:root {
  --spark-ui-radius-xs: 12px;
  --spark-ui-radius-sm: 15px;
  --spark-ui-radius-md: 18px;
  --spark-ui-radius-lg: 24px;
  --spark-ui-gap-xs: 6px;
  --spark-ui-gap-sm: 10px;
  --spark-ui-gap-md: 14px;
  --spark-ui-pad-card: 14px;
  --spark-ui-shadow-soft: 0 8px 22px rgba(5, 9, 78, 0.06);
  --spark-ui-shadow-panel: 0 18px 48px rgba(5, 9, 78, 0.1);
}

.spark-app { --spark-card: rgba(255, 255, 255, 0.88); }
[data-theme='dark'] .spark-app { --spark-card: rgba(8, 13, 45, 0.84); }
.spark-main { container-type: inline-size; }
.spark-main :where(h1, h2, h3, p) { text-wrap: balance; }
.spark-main :where(strong, h1, h2, h3, h4) { font-weight: 680; }
.spark-main :where(p, li, small, span, em) { overflow-wrap: anywhere; }
.spark-card, [data-spark-card], .ops-main-card, .production-notification-panel, .production-message-card, .my-space-profile-card, .my-space-passport-card, .my-space-next-card, .spark-simple-footer, .spark-home-preview {
  border-color: rgba(126, 144, 190, 0.17);
  box-shadow: var(--spark-ui-shadow-soft);
}
.spark-card, [data-spark-card] { padding: var(--spark-ui-pad-card); border-radius: var(--spark-ui-radius-md); }
.spark-card :where(h2, h3), [data-spark-card] :where(h2, h3) { margin-top: 6px; }
.spark-card :where(p), [data-spark-card] :where(p) { margin-top: 5px; }

/* Brand: readable text + usable icon. Do not rely on tiny text inside the logo asset. */
.spark-topbar .spark-brand-readable,
.spark-brand-readable {
  display: inline-flex !important;
  align-items: center !important;
  gap: 8px !important;
  min-width: 132px;
  color: var(--spark-navy);
  letter-spacing: 0 !important;
  line-height: 1;
}
[data-theme='dark'] .spark-brand-readable { color: #fff; }
.spark-brand-readable-mark {
  width: 50px;
  height: 50px;
  display: grid;
  place-items: center;
  flex: 0 0 auto;
  overflow: visible;
  border-radius: 0;
  background: transparent !important;
  box-shadow: none !important;
}
.spark-brand-readable-mark img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  transform: scale(1.55);
  transform-origin: center;
  background: transparent !important;
}
.spark-brand-readable-mark > span {
  width: 34px;
  height: 34px;
  border-radius: 13px;
  display: grid;
  place-items: center;
  color: #fff;
  background: linear-gradient(135deg, #5f43f5, #ff7a3d);
}
.spark-brand-readable-wordmark {
  display: grid;
  gap: 0;
  min-width: 58px;
}
.spark-brand-readable-wordmark strong {
  color: currentColor;
  font-size: 15px;
  line-height: .95;
  letter-spacing: -.045em;
  font-weight: 760;
}
.spark-brand-readable-wordmark small {
  margin-top: 2px;
  color: var(--spark-muted);
  font-size: 12px;
  line-height: .95;
  letter-spacing: -.015em;
  font-weight: 560;
}
.spark-brand-readable.compact { min-width: auto; }
.spark-brand-readable.compact .spark-brand-readable-mark { width: 38px; height: 38px; }

/* Public Home hero: active first impression surface. */
.spark-main .spark-home-hero.landing-hero-v26 {
  display: grid !important;
  grid-template-columns: minmax(0, 1.06fr) minmax(300px, .82fr) !important;
  gap: clamp(18px, 3vw, 34px) !important;
  align-items: center !important;
  min-height: auto !important;
  padding: clamp(22px, 4vw, 46px) !important;
  border-radius: 34px !important;
  border: 1px solid rgba(126, 144, 190, 0.17) !important;
  background:
    radial-gradient(circle at 10% 6%, rgba(95, 67, 245, .12), transparent 31%),
    radial-gradient(circle at 92% 20%, rgba(255, 128, 0, .14), transparent 28%),
    linear-gradient(135deg, rgba(255,255,255,.94), rgba(248,251,255,.76)) !important;
  box-shadow: var(--spark-ui-shadow-panel) !important;
}
[data-theme='dark'] .spark-main .spark-home-hero.landing-hero-v26 {
  background:
    radial-gradient(circle at 10% 6%, rgba(95, 67, 245, .2), transparent 31%),
    radial-gradient(circle at 92% 20%, rgba(255, 128, 0, .16), transparent 28%),
    linear-gradient(135deg, rgba(10,16,50,.94), rgba(7,12,38,.82)) !important;
}
.spark-home-kicker {
  display: inline-flex;
  width: fit-content;
  padding: 6px 10px;
  border-radius: 999px;
  border: 1px solid rgba(126, 144, 190, 0.18);
  background: rgba(255,255,255,.58);
  color: var(--spark-blue-strong);
  font-size: 11px;
  line-height: 1.1;
  letter-spacing: .04em;
  text-transform: uppercase;
  font-weight: 660;
}
[data-theme='dark'] .spark-home-kicker { background: rgba(255,255,255,.06); }
.spark-home-hero-copy h1 {
  max-width: 760px;
  margin: 12px 0 0 !important;
  color: var(--spark-navy);
  font-size: clamp(38px, 5.6vw, 72px) !important;
  line-height: .99 !important;
  letter-spacing: -.06em !important;
  font-weight: 710 !important;
}
[data-theme='dark'] .spark-home-hero-copy h1 { color: #fff; }
.spark-home-hero-copy p {
  max-width: 650px;
  margin: 16px 0 0 !important;
  color: var(--spark-muted);
  font-size: 15px !important;
  line-height: 1.62 !important;
  font-weight: 420 !important;
}
.spark-home-actions {
  display: flex !important;
  flex-wrap: wrap !important;
  gap: 9px !important;
  margin-top: 18px !important;
}
.spark-main .spark-home-actions .spark-btn {
  width: auto !important;
  min-width: 0 !important;
  flex: 0 0 auto !important;
  min-height: 41px !important;
  padding-inline: 14px !important;
  border-radius: 15px !important;
  font-size: 13px !important;
  font-weight: 640 !important;
}
.spark-home-proof-row {
  display: flex !important;
  flex-wrap: wrap !important;
  gap: 7px !important;
  margin-top: 14px !important;
}
.spark-home-proof-row span {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 6px 9px;
  border-radius: 999px;
  border: 1px solid rgba(126, 144, 190, 0.18);
  background: rgba(255,255,255,.58);
  color: var(--spark-muted);
  font-size: 11.5px;
  font-weight: 560;
}
[data-theme='dark'] .spark-home-proof-row span { background: rgba(255,255,255,.055); }
.spark-home-preview {
  padding: clamp(15px, 3vw, 22px);
  border: 1px solid rgba(126, 144, 190, 0.18);
  border-radius: 28px;
  background:
    radial-gradient(circle at 80% 8%, rgba(255, 128, 0, .18), transparent 24%),
    radial-gradient(circle at 22% 12%, rgba(95, 67, 245, .12), transparent 30%),
    rgba(255,255,255,.66);
  backdrop-filter: blur(12px);
}
[data-theme='dark'] .spark-home-preview { background: rgba(255,255,255,.055); }
.spark-home-preview-head {
  display: grid;
  grid-template-columns: 46px minmax(0,1fr);
  gap: 12px;
  align-items: center;
  padding: 12px;
  border-radius: 20px;
  border: 1px solid rgba(126,144,190,.16);
  background: rgba(255,255,255,.62);
}
[data-theme='dark'] .spark-home-preview-head { background: rgba(255,255,255,.055); }
.spark-home-preview-head > span {
  width: 42px;
  height: 42px;
  border-radius: 16px;
  display: grid;
  place-items: center;
  color: #fff;
  background: linear-gradient(135deg, #5f43f5, #ff7a3d);
}
.spark-home-preview-head small {
  color: var(--spark-muted);
  font-size: 11.5px;
  font-weight: 520;
}
.spark-home-preview-head strong {
  display: block;
  margin-top: 2px;
  color: var(--spark-navy);
  font-size: 17px;
  line-height: 1.12;
  letter-spacing: -.035em;
}
[data-theme='dark'] .spark-home-preview-head strong { color: #fff; }
.spark-home-preview-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0,1fr));
  gap: 8px;
  margin-top: 10px;
}
.spark-home-preview-grid a {
  min-height: 70px;
  padding: 10px 6px;
  display: grid;
  justify-items: center;
  align-content: center;
  gap: 4px;
  text-align: center;
  border: 1px solid rgba(126,144,190,.16);
  border-radius: 17px;
  background: rgba(255,255,255,.58);
  color: var(--spark-blue-strong);
}
[data-theme='dark'] .spark-home-preview-grid a { background: rgba(255,255,255,.05); }
.spark-home-preview-grid strong { font-size: 12.5px; line-height: 1.05; }
.spark-home-preview-grid small { color: var(--spark-muted); font-size: 10.5px; line-height: 1.1; font-weight: 420; }
.spark-home-preview-note {
  margin-top: 10px;
  padding: 12px;
  border-radius: 19px;
  border: 1px solid rgba(126,144,190,.16);
  background: rgba(255,255,255,.48);
}
[data-theme='dark'] .spark-home-preview-note { background: rgba(255,255,255,.04); }
.spark-home-preview-note strong { display: block; color: var(--spark-navy); font-size: 16px; line-height: 1.12; letter-spacing: -.03em; }
[data-theme='dark'] .spark-home-preview-note strong { color: #fff; }
.spark-home-preview-note p { margin: 6px 0 0; color: var(--spark-muted); font-size: 12.5px; line-height: 1.45; font-weight: 410; }

/* Compact CTA: not stacked jumbo buttons. */
.spark-home-cta.landing-cta-v26 {
  display: grid !important;
  grid-template-columns: minmax(0,1fr) auto !important;
  gap: 14px !important;
  align-items: center !important;
  padding: 18px !important;
  border-radius: 24px !important;
}
.spark-home-cta h2 { font-size: clamp(22px, 2.6vw, 32px) !important; line-height: 1.08 !important; }
.spark-home-cta p { max-width: 56ch; font-size: 13.5px !important; }
.spark-home-cta-actions { display: flex !important; flex-wrap: wrap !important; justify-content: flex-end !important; gap: 8px !important; }
.spark-main .spark-home-cta-actions .spark-btn { width: auto !important; min-height: 40px !important; padding-inline: 13px !important; border-radius: 14px !important; }

/* Dashboard: one combined card. No repeated status block below it. */
.spark-dashboard-board.ops-board { display: block !important; margin-bottom: 12px !important; }
.spark-dashboard-card.ops-main-card { padding: 16px !important; border-radius: 24px !important; }
.spark-dashboard-userline {
  display: grid; grid-template-columns: 38px minmax(0,1fr) auto; gap: 10px; align-items: center;
}
.spark-dashboard-userline > span { width: 38px; height: 38px; border-radius: 15px; display: grid; place-items: center; color: var(--spark-blue-strong); background: rgba(95,67,245,.1); font-weight: 700; }
.spark-dashboard-userline small { display: block; color: var(--spark-muted); font-size: 11.5px; font-weight: 500; }
.spark-dashboard-userline strong { display: block; color: var(--spark-navy); font-size: 15px; line-height: 1.1; }
[data-theme='dark'] .spark-dashboard-userline strong { color: #fff; }
.spark-dashboard-userline a { padding: 7px 9px; border-radius: 999px; border: 1px solid rgba(126,144,190,.18); color: var(--spark-blue-strong); background: rgba(255,255,255,.62); font-size: 11.5px; font-weight: 630; }
[data-theme='dark'] .spark-dashboard-userline a { background: rgba(255,255,255,.055); }
.spark-dashboard-focus { display: grid; grid-template-columns: 42px minmax(0,1fr); gap: 12px; align-items: center; margin-top: 14px; padding: 13px; border-radius: 20px; border: 1px solid rgba(126,144,190,.15); background: rgba(255,255,255,.54); }
[data-theme='dark'] .spark-dashboard-focus { background: rgba(255,255,255,.045); }
.spark-dashboard-focus > span { width: 40px; height: 40px; display: grid; place-items: center; border-radius: 15px; color: var(--spark-blue-strong); background: rgba(95,67,245,.1); }
.spark-dashboard-focus small { color: var(--spark-muted); font-size: 11.5px; font-weight: 500; }
.spark-dashboard-focus h1 { margin: 2px 0 0 !important; color: var(--spark-navy); font-size: clamp(22px, 3vw, 34px) !important; line-height: 1.08 !important; letter-spacing: -.04em !important; font-weight: 680 !important; }
[data-theme='dark'] .spark-dashboard-focus h1 { color: #fff; }
.spark-dashboard-focus p { margin: 5px 0 0 !important; max-width: 58ch; color: var(--spark-muted); font-size: 13px !important; line-height: 1.48 !important; font-weight: 410 !important; }
.spark-dashboard-lanes { display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); gap: 8px; margin-top: 10px; }
.spark-dashboard-lanes a { min-height: 64px; display: grid; justify-items: center; align-content: center; gap: 2px; padding: 8px 4px; text-align: center; border-radius: 16px; border: 1px solid rgba(126,144,190,.16); background: rgba(255,255,255,.58); color: var(--spark-blue-strong); }
[data-theme='dark'] .spark-dashboard-lanes a { background: rgba(255,255,255,.05); }
.spark-dashboard-lanes strong { color: var(--spark-navy); font-size: 21px; line-height: .95; letter-spacing: -.04em; }
[data-theme='dark'] .spark-dashboard-lanes strong { color: #fff; }
.spark-dashboard-lanes small { color: var(--spark-muted); font-size: 10.5px; line-height: 1.1; font-weight: 520; }
.spark-dashboard-progress { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 8px; margin-top: 10px; }
.spark-dashboard-progress span { min-height: 44px; padding: 8px 10px; border-radius: 15px; border: 1px solid rgba(126,144,190,.16); background: rgba(255,255,255,.46); }
[data-theme='dark'] .spark-dashboard-progress span { background: rgba(255,255,255,.045); }
.spark-dashboard-progress strong { display: block; color: var(--spark-navy); font-size: 16px; line-height: 1; }
[data-theme='dark'] .spark-dashboard-progress strong { color: #fff; }
.spark-dashboard-progress small { color: var(--spark-muted); font-size: 10.5px; }
.spark-dashboard-actions { margin-top: 12px !important; gap: 8px !important; }
.spark-dashboard-actions .spark-btn { flex: 1 1 0; min-height: 40px !important; }
.pass35b2-quick-panel { display: none !important; }
.pass35b-metric-grid, .pass35b-action-strip { display: none !important; }

/* Drawer: utility sheet only. */
.pass35b2-drawer-head { display: flex !important; align-items: center !important; justify-content: space-between !important; }
.pass35b2-drawer-head strong { font-size: 26px !important; line-height: 1 !important; letter-spacing: -.05em !important; }
.drawer-quick-actions { display: none !important; }
.pass35b2-drawer-links a, .pass35b2-drawer-links button { min-height: 58px !important; }

/* Footer and bottom nav. */
.pass35b-public-home + .spark-landing-footer, .spark-landing-footer:empty { display: none; }
.pass35b-simple-footer.spark-simple-footer { width: min(1080px, calc(100% - 28px)); margin: clamp(18px, 4vw, 34px) auto calc(86px + env(safe-area-inset-bottom, 0px)); padding: 18px; border-radius: 24px; display: grid; grid-template-columns: minmax(0,1.2fr) auto; gap: 14px 24px; align-items: center; background: rgba(255,255,255,.68); backdrop-filter: blur(14px); }
[data-theme='dark'] .pass35b-simple-footer.spark-simple-footer { background: rgba(255,255,255,.045); }
.pass35b-simple-footer .simple-footer-brandline { display: grid; grid-template-columns: auto minmax(0,1fr); gap: 12px; align-items: center; }
.pass35b-simple-footer p { margin: 0; max-width: 64ch; color: var(--spark-muted); font-size: 12.5px; line-height: 1.5; font-weight: 430; }
.pass35b-simple-footer nav { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 10px; }
.pass35b-simple-footer nav a { color: var(--spark-muted); font-size: 12px; font-weight: 610; }
.pass35b-simple-footer small { grid-column: 1 / -1; color: var(--spark-muted); font-size: 11px; font-weight: 420; }
.pass35b-bottom-nav.spark-bottom-nav { transition: transform .22s ease, opacity .22s ease, box-shadow .22s ease; will-change: transform; }
.pass35b-bottom-nav.spark-bottom-nav.hidden { transform: translateY(calc(100% + 18px)); opacity: 0; pointer-events: none; }
@media (prefers-reduced-motion: reduce) { .pass35b-bottom-nav.spark-bottom-nav { transition: none; } }

/* Mobile foundation. */
@media (max-width: 760px) {
  .spark-app { font-size: 13.5px; line-height: 1.5; }
  .spark-topbar { height: 68px; padding: 9px 12px; }
  .spark-main { padding: 10px 10px 96px !important; }
  .spark-main :where(h1) { font-size: clamp(25px, 7.6vw, 34px) !important; line-height: 1.07 !important; letter-spacing: -.038em !important; font-weight: 650 !important; }
  .spark-main :where(h2) { font-size: clamp(19px, 5.4vw, 25px) !important; line-height: 1.13 !important; letter-spacing: -.028em !important; font-weight: 640 !important; }
  .spark-main :where(h3) { font-size: 15.25px !important; line-height: 1.18 !important; font-weight: 610 !important; }
  .spark-main :where(p, li, input, textarea, select) { font-size: 13.25px !important; line-height: 1.52 !important; font-weight: 390 !important; }
  .spark-main :where(small, em, label span) { font-size: 11.25px !important; line-height: 1.35 !important; font-weight: 390 !important; }
  .spark-main :where(strong) { font-weight: 620 !important; }
  .spark-eyebrow, .spark-sidebar-head span { font-size: 10px !important; letter-spacing: .1em !important; font-weight: 650 !important; }
  .spark-card, [data-spark-card], .ops-main-card, .my-space-profile-card, .my-space-passport-card, .my-space-next-card, .production-message-card { padding: 12px !important; border-radius: 16px !important; box-shadow: 0 6px 16px rgba(5,9,78,.055) !important; }

  .spark-topbar .spark-brand-readable { min-width: 116px !important; gap: 7px !important; }
  .spark-brand-readable-mark { width: 48px !important; height: 48px !important; }
  .spark-brand-readable-wordmark strong { font-size: 14px; }
  .spark-brand-readable-wordmark small { font-size: 11.5px; }
  .spark-brand-readable.compact .spark-brand-readable-mark { width: 38px !important; height: 38px !important; }
  .spark-brand-readable.compact .spark-brand-readable-wordmark { display: none; }

  .spark-main .spark-home-hero.landing-hero-v26 {
    grid-template-columns: 1fr !important;
    gap: 14px !important;
    padding: 18px !important;
    border-radius: 26px !important;
  }
  .spark-home-hero-copy h1 { font-size: clamp(31px, 9vw, 42px) !important; line-height: 1.02 !important; }
  .spark-home-hero-copy p { margin-top: 12px !important; font-size: 13.75px !important; line-height: 1.56 !important; }
  .spark-home-actions { display: grid !important; grid-template-columns: 1fr 1fr !important; gap: 8px !important; margin-top: 14px !important; }
  .spark-main .spark-home-actions .spark-btn { width: 100% !important; min-height: 39px !important; padding-inline: 10px !important; border-radius: 14px !important; font-size: 12.5px !important; }
  .spark-home-proof-row { gap: 6px !important; margin-top: 10px !important; }
  .spark-home-proof-row span { padding: 5px 8px; font-size: 10.75px; }
  .spark-home-preview { padding: 13px !important; border-radius: 22px !important; }
  .spark-home-preview-head { grid-template-columns: 40px 1fr; padding: 10px; border-radius: 17px; }
  .spark-home-preview-head > span { width: 38px; height: 38px; border-radius: 14px; }
  .spark-home-preview-head strong { font-size: 14.5px; }
  .spark-home-preview-grid { grid-template-columns: repeat(4, minmax(0,1fr)); gap: 6px; }
  .spark-home-preview-grid a { min-height: 58px; padding: 7px 4px; border-radius: 14px; }
  .spark-home-preview-grid strong { font-size: 11px; }
  .spark-home-preview-grid small { display: none; }
  .spark-home-preview-note { padding: 10px; border-radius: 16px; }
  .spark-home-preview-note strong { font-size: 14px; }
  .spark-home-preview-note p { font-size: 11.75px; }

  .spark-home-cta.landing-cta-v26 { grid-template-columns: 1fr !important; gap: 10px !important; padding: 14px !important; border-radius: 20px !important; }
  .spark-home-cta h2 { font-size: 21px !important; }
  .spark-home-cta p { font-size: 12.75px !important; }
  .spark-home-cta-actions { display: grid !important; grid-template-columns: 1fr 1fr !important; justify-content: stretch !important; }
  .spark-main .spark-home-cta-actions .spark-btn { width: 100% !important; min-height: 38px !important; }

  .spark-dashboard-card.ops-main-card { padding: 12px !important; border-radius: 20px !important; }
  .spark-dashboard-userline { grid-template-columns: 34px minmax(0,1fr) auto; gap: 8px; }
  .spark-dashboard-userline > span { width: 34px; height: 34px; border-radius: 13px; }
  .spark-dashboard-userline a { font-size: 10.5px; padding: 6px 8px; }
  .spark-dashboard-focus { grid-template-columns: 36px minmax(0,1fr); gap: 9px; padding: 10px; border-radius: 17px; }
  .spark-dashboard-focus > span { width: 34px; height: 34px; border-radius: 13px; }
  .spark-dashboard-focus h1 { font-size: 21px !important; }
  .spark-dashboard-focus p { font-size: 12.25px !important; }
  .spark-dashboard-lanes { gap: 6px; }
  .spark-dashboard-lanes a { min-height: 58px; padding: 7px 3px; border-radius: 14px; }
  .spark-dashboard-lanes strong { font-size: 18px; }
  .spark-dashboard-lanes small { font-size: 10px; }
  .spark-dashboard-progress { gap: 6px; }
  .spark-dashboard-progress span { min-height: 39px; padding: 7px 8px; border-radius: 13px; }
  .spark-dashboard-actions .spark-btn { min-height: 38px !important; }

  .pass35b2-drawer-head strong { font-size: 24px !important; }
  .pass35b2-drawer-links a, .pass35b2-drawer-links button { min-height: 55px !important; }
  .spark-bottom-nav { left: 10px !important; right: 10px !important; bottom: max(8px, env(safe-area-inset-bottom,0px)) !important; padding: 6px !important; border-radius: 21px !important; }
  .spark-bottom-nav a { min-height: 46px !important; border-radius: 16px !important; font-size: 10.25px !important; font-weight: 610 !important; }
