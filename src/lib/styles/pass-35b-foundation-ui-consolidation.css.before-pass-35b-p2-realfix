/* Pass 35B — Foundation UI Consolidation
   Integrated through Patch 2: de-duplicate dashboard surfaces, rebuild public hero,
   simplify mobile drawer, keep one foundation layer instead of adding new CSS imports. */

:root {
  --spark-ui-radius-xs: 12px;
  --spark-ui-radius-sm: 15px;
  --spark-ui-radius-md: 18px;
  --spark-ui-radius-lg: 24px;
  --spark-ui-gap-xs: 6px;
  --spark-ui-gap-sm: 10px;
  --spark-ui-gap-md: 14px;
  --spark-ui-pad-card: 14px;
  --spark-ui-shadow-soft: 0 8px 22px rgba(5, 9, 78, 0.06);
  --spark-ui-shadow-panel: 0 18px 48px rgba(5, 9, 78, 0.1);
}

.spark-app {
  --spark-card: rgba(255, 255, 255, 0.88);
}

[data-theme='dark'] .spark-app {
  --spark-card: rgba(8, 13, 45, 0.84);
}

.spark-main {
  container-type: inline-size;
}

.spark-main :where(h1, h2, h3, p) {
  text-wrap: balance;
}

.spark-main :where(strong, h1, h2, h3, h4) {
  font-weight: 680;
}

.spark-main :where(p, li, small, span, em) {
  overflow-wrap: anywhere;
}

.spark-card,
[data-spark-card],
.ops-main-card,
.ops-readiness-card,
.pass35-auth-card,
.pass35-auth-intro,
.production-notification-panel,
.production-message-card,
.my-space-profile-card,
.my-space-passport-card,
.my-space-next-card,
.spark-simple-footer,
.pass35b2-product-preview,
.pass35b2-quick-panel {
  border-color: rgba(126, 144, 190, 0.17);
  box-shadow: var(--spark-ui-shadow-soft);
}

.spark-card,
[data-spark-card] {
  padding: var(--spark-ui-pad-card);
  border-radius: var(--spark-ui-radius-md);
}

.spark-card :where(h2, h3),
[data-spark-card] :where(h2, h3) {
  margin-top: 6px;
}

.spark-card :where(p),
[data-spark-card] :where(p) {
  margin-top: 5px;
}

.spark-card :where(small),
[data-spark-card] :where(small) {
  letter-spacing: -0.005em;
}

/* Brand: visible mark + readable wordmark, instead of an unreadably small full logo. */
.pass35b2-brand.production-brand {
  gap: 8px;
  letter-spacing: 0;
}

.production-brand-logo.pass35b2-brand-logo {
  width: clamp(48px, 8vw, 64px);
  height: clamp(48px, 8vw, 64px);
  border-radius: 0;
  background: transparent !important;
  box-shadow: none !important;
  flex: 0 0 auto;
}

.production-brand-logo.pass35b2-brand-logo img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  background: transparent !important;
}

.pass35b2-brand-wordmark {
  display: grid;
  gap: 0;
  line-height: 1;
  color: var(--spark-navy);
}

[data-theme='dark'] .pass35b2-brand-wordmark {
  color: #fff;
}

.pass35b2-brand-wordmark strong {
  font-size: 14px;
  letter-spacing: -0.04em;
  font-weight: 740;
}

.pass35b2-brand-wordmark small {
  margin-top: 1px;
  color: var(--spark-muted);
  font-size: 12px;
  letter-spacing: -0.02em;
  font-weight: 560;
}

/* Public hero: one clear product face, compact CTA, useful preview. */
.pass35b2-hero.landing-hero-v26 {
  display: grid;
  grid-template-columns: minmax(0, 1.05fr) minmax(320px, 0.82fr);
  gap: clamp(18px, 3vw, 34px);
  align-items: center;
  padding-block: clamp(18px, 4vw, 42px);
}

.pass35b2-hero-copy h1 {
  max-width: 760px;
  font-size: clamp(42px, 6vw, 78px);
  line-height: 0.98;
  letter-spacing: -0.065em;
  font-weight: 720;
}

.pass35b2-hero-copy p {
  max-width: 650px;
  color: var(--spark-muted);
  font-size: 15.5px;
  line-height: 1.65;
  font-weight: 430;
}

.pass35b2-kicker-row {
  align-items: center;
  gap: 8px;
}

.pass35b2-kicker-row > span:last-child {
  color: var(--spark-muted);
  font-size: 12px;
  font-weight: 560;
}

.pass35b2-hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 9px;
  margin-top: 18px;
}

.pass35b2-hero-actions .spark-btn {
  min-height: 42px;
  border-radius: 15px;
}

.pass35b2-trust-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
  margin-top: 14px;
}

.pass35b2-trust-chips span {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 7px 10px;
  border: 1px solid rgba(126, 144, 190, 0.18);
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.58);
  color: var(--spark-muted);
  font-size: 12px;
  font-weight: 570;
}

[data-theme='dark'] .pass35b2-trust-chips span {
  background: rgba(255, 255, 255, 0.055);
}

.pass35b2-product-preview {
  position: relative;
  overflow: hidden;
  padding: clamp(16px, 3vw, 24px);
  border: 1px solid rgba(126, 144, 190, 0.18);
  border-radius: 30px;
  background:
    radial-gradient(circle at 78% 8%, rgba(255, 128, 0, 0.18), transparent 24%),
    radial-gradient(circle at 28% 18%, rgba(92, 63, 255, 0.14), transparent 34%),
    linear-gradient(180deg, rgba(255,255,255,0.92), rgba(248,251,255,0.74));
}

[data-theme='dark'] .pass35b2-product-preview {
  background:
    radial-gradient(circle at 78% 8%, rgba(255, 128, 0, 0.18), transparent 24%),
    radial-gradient(circle at 28% 18%, rgba(92, 63, 255, 0.2), transparent 34%),
    linear-gradient(180deg, rgba(11,17,48,0.94), rgba(7,12,38,0.82));
}

.preview-main-step {
  display: grid;
  grid-template-columns: 54px minmax(0, 1fr);
  gap: 12px;
  align-items: center;
  padding: 14px;
  border: 1px solid rgba(126, 144, 190, 0.16);
  border-radius: 22px;
  background: rgba(255,255,255,0.72);
}

[data-theme='dark'] .preview-main-step {
  background: rgba(255,255,255,0.06);
}

.preview-main-step > span {
  display: grid;
  place-items: center;
  width: 48px;
  height: 48px;
  border-radius: 18px;
  color: #fff;
  background: linear-gradient(135deg, #5f43f5, #3c2bd6);
}

.preview-main-step small {
  color: var(--spark-muted);
  font-size: 12px;
  font-weight: 520;
}

.preview-main-step strong {
  display: block;
  margin-top: 2px;
  color: var(--spark-navy);
  font-size: 21px;
  line-height: 1.1;
  letter-spacing: -0.035em;
  font-weight: 690;
}

[data-theme='dark'] .preview-main-step strong {
  color: #fff;
}

.preview-main-step p {
  margin: 5px 0 0;
  color: var(--spark-muted);
  font-size: 13px;
  line-height: 1.45;
  font-weight: 410;
}

.preview-step-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8px;
  margin-top: 10px;
}

.preview-step-grid a {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  min-height: 42px;
  padding: 9px 10px;
  border: 1px solid rgba(126, 144, 190, 0.18);
  border-radius: 16px;
  background: rgba(255,255,255,0.64);
  color: var(--spark-blue-strong);
  font-size: 13px;
  font-weight: 630;
}

[data-theme='dark'] .preview-step-grid a {
  background: rgba(255,255,255,0.055);
}

.preview-caption {
  margin-top: 10px;
  padding: 14px;
  border: 1px solid rgba(126, 144, 190, 0.16);
  border-radius: 20px;
  background: rgba(255,255,255,0.52);
}

[data-theme='dark'] .preview-caption {
  background: rgba(255,255,255,0.04);
}

.preview-caption strong {
  display: block;
  color: var(--spark-navy);
  font-size: 18px;
  line-height: 1.1;
  letter-spacing: -0.035em;
}

[data-theme='dark'] .preview-caption strong {
  color: #fff;
}

.preview-caption p {
  margin: 7px 0 0;
  color: var(--spark-muted);
  font-size: 13px;
  line-height: 1.5;
  font-weight: 410;
}

.pass35b2-cta.landing-cta-v26 {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 16px;
  align-items: center;
  padding: clamp(16px, 3vw, 24px);
  border-radius: 26px;
}

.pass35b2-cta h2 {
  font-size: clamp(24px, 3vw, 36px);
}

.pass35b2-cta p {
  max-width: 58ch;
}

.pass35b2-cta-actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 9px;
}

/* Dashboard: de-duplicated status + one quick panel. */
.pass35b2-ops-board.ops-board {
  display: block;
  margin-bottom: 10px;
}

.pass35b2-daily-card.ops-main-card {
  border-radius: 24px;
  padding: 18px;
}

.pass35b2-user-line.ops-user-line {
  display: grid;
  grid-template-columns: 38px minmax(0, 1fr) auto;
  gap: 10px;
  align-items: center;
}

.pass35b2-user-line > span {
  width: 38px;
  height: 38px;
  border-radius: 15px;
  font-size: 15px;
}

.pass35b2-user-line small {
  display: block;
  color: var(--spark-muted);
  font-size: 11.5px;
  font-weight: 500;
}

.pass35b2-user-line strong {
  display: block;
  color: var(--spark-navy);
  font-size: 15px;
  line-height: 1.15;
  font-weight: 680;
}

[data-theme='dark'] .pass35b2-user-line strong {
  color: #fff;
}

.pass35b2-user-line a {
  padding: 7px 10px;
  border: 1px solid rgba(126, 144, 190, 0.18);
  border-radius: 999px;
  color: var(--spark-blue-strong);
  background: rgba(255,255,255,0.55);
  font-size: 11.5px;
  font-weight: 640;
}

[data-theme='dark'] .pass35b2-user-line a {
  background: rgba(255,255,255,0.06);
}

.pass35b2-focus.ops-focus {
  display: grid;
  grid-template-columns: 46px minmax(0, 1fr);
  gap: 12px;
  align-items: center;
  margin-top: 14px;
}

.pass35b2-focus > span {
  display: grid;
  place-items: center;
  width: 46px;
  height: 46px;
  border-radius: 17px;
}

.pass35b2-focus small {
  color: var(--spark-muted);
  font-size: 12px;
  font-weight: 500;
}

.pass35b2-focus h1 {
  margin: 2px 0 0;
  font-size: clamp(24px, 3vw, 38px);
  line-height: 1.05;
  letter-spacing: -0.045em;
}

.pass35b2-focus p {
  max-width: 60ch;
  margin-top: 6px;
  color: var(--spark-muted);
  font-size: 13.5px;
  line-height: 1.5;
  font-weight: 410;
}

.pass35b2-progress-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8px;
  margin-top: 12px;
}

.pass35b2-progress-row span {
  display: grid;
  justify-items: center;
  gap: 2px;
  padding: 10px;
  border: 1px solid rgba(126, 144, 190, 0.16);
  border-radius: 17px;
  background: rgba(255,255,255,0.52);
}

[data-theme='dark'] .pass35b2-progress-row span {
  background: rgba(255,255,255,0.05);
}

.pass35b2-progress-row strong {
  color: var(--spark-navy);
  font-size: 21px;
  line-height: 1;
  letter-spacing: -0.04em;
}

[data-theme='dark'] .pass35b2-progress-row strong {
  color: #fff;
}

.pass35b2-progress-row small {
  color: var(--spark-muted);
  font-size: 11px;
  font-weight: 540;
}

.pass35b2-actions.ops-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 9px;
  margin-top: 12px;
}

.pass35b2-actions .spark-btn {
  width: 100%;
}

.pass35b2-quick-panel {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 8px;
  margin: 10px 0 14px;
  padding: 10px;
  border: 1px solid rgba(126, 144, 190, 0.16);
  border-radius: 24px;
  background: rgba(255,255,255,0.46);
  backdrop-filter: blur(14px);
}

[data-theme='dark'] .pass35b2-quick-panel {
  background: rgba(255,255,255,0.035);
}

.pass35b2-quick-panel a {
  display: grid;
  grid-template-columns: 34px minmax(0, 1fr);
  align-items: center;
  gap: 8px;
  min-height: 58px;
  padding: 10px;
  border: 1px solid rgba(126, 144, 190, 0.15);
  border-radius: 17px;
  background: rgba(255,255,255,0.66);
}

[data-theme='dark'] .pass35b2-quick-panel a {
  background: rgba(255,255,255,0.055);
}

.pass35b2-quick-panel a > span {
  display: grid;
  place-items: center;
  width: 34px;
  height: 34px;
  border-radius: 13px;
  color: var(--spark-blue-strong);
  background: rgba(92, 63, 255, 0.1);
}

.pass35b2-quick-panel strong {
  display: block;
  color: var(--spark-navy);
  font-size: 18px;
  line-height: 1;
  font-weight: 680;
}

[data-theme='dark'] .pass35b2-quick-panel strong {
  color: #fff;
}

.pass35b2-quick-panel small {
  display: block;
  margin-top: 2px;
  color: var(--spark-muted);
  font-size: 11px;
  line-height: 1.2;
  font-weight: 520;
}

.pass35b-flow-checklist.spark-app-flow-checklist {
  margin-top: 0;
}

.pass35b-flow-checklist .flow-checklist-head {
  gap: 12px;
  align-items: center;
}

.pass35b-flow-checklist .flow-checklist-head h2 {
  font-size: clamp(24px, 3vw, 34px);
  line-height: 1.08;
}

.pass35b-flow-checklist .flow-checklist-head p {
  max-width: 62ch;
  font-size: 13.5px;
  line-height: 1.55;
  font-weight: 420;
}

.pass35b-flow-checklist .flow-checklist-grid {
  gap: 8px;
}

.pass35b-flow-checklist .flow-checklist-grid a {
  min-height: 58px;
  padding: 10px;
  border-radius: 16px;
  grid-template-columns: 34px minmax(0, 1fr) auto;
}

.pass35b-flow-checklist .flow-checklist-grid a > span:first-child {
  width: 34px;
  height: 34px;
  border-radius: 13px;
}

/* Drawer is now a utility sheet, not a duplicated mini-nav. */
.pass35b2-drawer.production-drawer {
  max-height: min(760px, calc(100svh - 92px));
  overflow-y: auto;
}

.pass35b2-drawer-head.production-drawer-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding-bottom: 2px;
}

.pass35b2-drawer-head strong {
  font-size: 28px;
  line-height: 1;
  letter-spacing: -0.05em;
}

.pass35b2-drawer-head button {
  display: grid;
  place-items: center;
  width: 46px;
  height: 46px;
  border: 0;
  border-radius: 17px;
  color: var(--spark-blue-strong);
  background: rgba(92, 63, 255, 0.11);
}

.pass35b2-drawer-account.production-drawer-account {
  margin-top: 10px;
}

.pass35b2-drawer-theme.production-drawer-theme {
  margin-top: 8px;
}

.pass35b2-drawer-links.production-drawer-links {
  margin-top: 10px;
  gap: 7px;
}

.pass35b2-drawer-links a,
.pass35b2-drawer-links button {
  grid-template-columns: 40px minmax(0, 1fr) auto;
  min-height: 58px;
  padding: 10px 12px;
  border-radius: 18px;
}

.pass35b2-drawer-links a > span:first-child,
.pass35b2-drawer-links button > span:first-child {
  width: 38px;
  height: 38px;
  border-radius: 14px;
}

.pass35b2-drawer-links strong {
  font-size: 14px;
  line-height: 1.1;
  letter-spacing: -0.02em;
}

.pass35b2-drawer-links small {
  margin-top: 2px;
  font-size: 12px;
  line-height: 1.25;
  font-weight: 430;
}

/* Footer consolidation: public pages use only SparkSimpleFooter. */
.pass35b-public-home + .spark-landing-footer,
.spark-landing-footer:empty {
  display: none;
}

.pass35b-simple-footer.spark-simple-footer {
  width: min(1080px, calc(100% - 28px));
  margin: clamp(18px, 4vw, 34px) auto calc(86px + env(safe-area-inset-bottom, 0px));
  padding: 18px;
  border-radius: 24px;
  display: grid;
  grid-template-columns: minmax(0, 1.2fr) auto;
  gap: 14px 24px;
  align-items: center;
  background: rgba(255, 255, 255, 0.68);
  backdrop-filter: blur(14px);
}

[data-theme='dark'] .pass35b-simple-footer.spark-simple-footer {
  background: rgba(255, 255, 255, 0.045);
}

.pass35b-simple-footer .simple-footer-brandline {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr);
  gap: 12px;
  align-items: center;
}

.pass35b-simple-footer p {
  margin: 0;
  max-width: 64ch;
  color: var(--spark-muted);
  font-size: 12.5px;
  line-height: 1.5;
  font-weight: 430;
}

.pass35b-simple-footer nav {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 10px;
}

.pass35b-simple-footer nav a {
  color: var(--spark-muted);
  font-size: 12px;
  font-weight: 610;
}

.pass35b-simple-footer nav a:hover {
  color: var(--spark-blue-strong);
}

.pass35b-simple-footer small {
  grid-column: 1 / -1;
  color: var(--spark-muted);
  font-size: 11px;
  font-weight: 420;
}

/* Bottom nav auto-hide. */
.pass35b-bottom-nav.spark-bottom-nav {
  transition: transform 0.22s ease, opacity 0.22s ease, box-shadow 0.22s ease;
  will-change: transform;
}

.pass35b-bottom-nav.spark-bottom-nav.hidden {
  transform: translateY(calc(100% + 18px));
  opacity: 0;
  pointer-events: none;
}

@media (prefers-reduced-motion: reduce) {
  .pass35b-bottom-nav.spark-bottom-nav {
    transition: none;
  }
}

/* Mobile foundation. */
@media (max-width: 760px) {
  .spark-app {
    font-size: 13.5px;
    line-height: 1.5;
  }

  .spark-topbar {
    height: 68px;
    padding: 9px 12px;
  }

  .spark-main {
    padding: 10px 10px 96px !important;
  }

  .spark-main :where(h1) {
    font-size: clamp(25px, 7.6vw, 34px) !important;
    line-height: 1.07 !important;
    letter-spacing: -0.038em !important;
    font-weight: 650 !important;
  }

  .spark-main :where(h2) {
    font-size: clamp(19px, 5.4vw, 25px) !important;
    line-height: 1.13 !important;
    letter-spacing: -0.028em !important;
    font-weight: 640 !important;
  }

  .spark-main :where(h3) {
    font-size: 15.25px !important;
    line-height: 1.18 !important;
    font-weight: 610 !important;
  }

  .spark-main :where(p, li, input, textarea, select) {
    font-size: 13.25px !important;
    line-height: 1.52 !important;
    font-weight: 390 !important;
  }

  .spark-main :where(small, em, label span) {
    font-size: 11.25px !important;
    line-height: 1.35 !important;
    font-weight: 390 !important;
  }

  .spark-main :where(strong) {
    font-weight: 620 !important;
  }

  .spark-eyebrow,
  .spark-sidebar-head span {
    font-size: 10px !important;
    letter-spacing: 0.1em !important;
    font-weight: 650 !important;
  }

  .spark-card,
  [data-spark-card],
  .ops-main-card,
  .ops-readiness-card,
  .my-space-profile-card,
  .my-space-passport-card,
  .my-space-next-card,
  .production-message-card,
  .pass35b2-product-preview,
  .pass35b2-quick-panel {
    padding: 12px !important;
    border-radius: 16px !important;
    box-shadow: 0 6px 16px rgba(5, 9, 78, 0.055) !important;
  }

  .production-brand-logo.pass35b2-brand-logo {
    width: 54px;
    height: 54px;
  }

  .pass35b2-brand-wordmark strong {
    font-size: 12.5px;
  }

  .pass35b2-brand-wordmark small {
    font-size: 11px;
  }

  .spark-brand.compact .production-brand-logo.pass35b2-brand-logo {
    width: 42px;
    height: 42px;
  }

  .pass35b2-hero.landing-hero-v26 {
    grid-template-columns: 1fr;
    gap: 14px;
    padding-block: 14px;
  }

  .pass35b2-hero-copy h1 {
    font-size: clamp(35px, 10.5vw, 48px) !important;
    line-height: 1.02 !important;
    letter-spacing: -0.055em !important;
  }

  .pass35b2-hero-copy p {
    font-size: 14px !important;
    line-height: 1.58 !important;
  }

  .pass35b2-hero-actions {
    display: grid;
    grid-template-columns: 1fr;
    gap: 8px;
    margin-top: 14px;
  }

  .pass35b2-hero-actions .spark-btn {
    width: 100%;
    min-height: 42px !important;
  }

  .pass35b2-trust-chips {
    gap: 6px;
    margin-top: 10px;
  }

  .pass35b2-trust-chips span {
    padding: 6px 9px;
    font-size: 11.5px;
  }

  .pass35b2-product-preview {
    padding: 12px !important;
    border-radius: 22px !important;
  }

