<script lang="ts">
  import { onMount } from 'svelte';
  import SparkButton from './SparkButton.svelte';
  import SparkCard from './SparkCard.svelte';
  import SparkIcon from './SparkIcon.svelte';
  import SparkPreviewToggle from '$shell/SparkPreviewToggle.svelte';
  import { pushToast } from '$state/app-state.svelte';
  import { learningState, setExperience, type ExperienceLevel } from '$state/learning-state.svelte';
  import { setThemePreference, themeState, type ThemePreference } from '$state/theme-state.svelte';
  import { contentStudioState, getManagedCopy, restoreManagedContent } from '$state/content-studio-state.svelte';

  const fallbackSettingsCopy = {
    eyebrow: 'Pengaturan',
    title: 'Atur Spark agar nyaman untuk cara belajarmu.',
    description:
      'Pilih tampilan, cara belajar, arahan, dan pengingat yang membuat perjalanan menuju Starknet terasa lebih tenang.',
    primaryCtaLabel: 'Buka Studio',
    primaryCtaHref: '/studio',
    secondaryCtaLabel: 'Lihat Profile',
    secondaryCtaHref: '/profile',
    note: 'Settings menjaga pengalaman belajar tetap sederhana. Identitas dan Passport tetap dikelola dari Profile.'
  };

  const themes: { key: ThemePreference; title: string; copy: string; icon: string }[] = [
    { key: 'system', title: 'Ikuti perangkat', copy: 'Spark menyesuaikan tampilan dengan layar yang kamu pakai.', icon: 'settings' },
    { key: 'light', title: 'Terang', copy: 'Nyaman untuk belajar di ruang terang atau siang hari.', icon: 'sun' },
    { key: 'dark', title: 'Gelap', copy: 'Lebih lembut untuk malam atau layar redup.', icon: 'moon' }
  ];

  const learningModes: { key: ExperienceLevel; title: string; copy: string; icon: string }[] = [
    { key: 'beginner', title: 'Pemula', copy: 'Penjelasan lebih pelan, istilah baru dibuka bertahap.', icon: 'sparkles' },
    { key: 'guided', title: 'Terarah', copy: 'Spark membantu menjaga urutan belajar tetap rapi.', icon: 'target' },
    { key: 'explorer', title: 'Penjelajah', copy: 'Lebih bebas membuka modul, lab, dan resource lanjutan.', icon: 'compass' }
  ];

  let guidanceEnabled = $state(true);
  let remindersEnabled = $state(true);
  let safetyTipsEnabled = $state(true);
  let confirmResetOpen = $state(false);

  const settingsCopy = $derived(getManagedCopy('settings-hero') ?? fallbackSettingsCopy);

  onMount(() => {
    if (!contentStudioState.restored) restoreManagedContent();
  });

  function chooseTheme(theme: ThemePreference) {
    setThemePreference(theme);
    pushToast({ title: 'Tampilan diperbarui', copy: theme === 'system' ? 'Spark mengikuti tampilan perangkatmu.' : `Spark memakai mode ${theme === 'dark' ? 'gelap' : 'terang'}.`, tone: 'success' });
  }

  function chooseMode(mode: ExperienceLevel) {
    setExperience(mode);
    pushToast({ title: 'Cara belajar diperbarui', copy: mode === 'beginner' ? 'Spark akan memberi arahan lebih pelan.' : mode === 'guided' ? 'Spark akan menjaga jalur tetap terarah.' : 'Spark membuka ruang eksplorasi lebih luas.', tone: 'success' });
  }

  function toggleGuidance(key: 'guidance' | 'reminders' | 'safety') {
    if (key === 'guidance') guidanceEnabled = !guidanceEnabled;
    if (key === 'reminders') remindersEnabled = !remindersEnabled;
    if (key === 'safety') safetyTipsEnabled = !safetyTipsEnabled;
    pushToast({ title: 'Pengaturan disimpan', copy: 'Preferensi arahan Spark diperbarui.', tone: 'success' });
  }

  function resetPreferences() {
    setThemePreference('system');
    setExperience('beginner');
    guidanceEnabled = true;
    remindersEnabled = true;
    safetyTipsEnabled = true;
    confirmResetOpen = false;
    pushToast({ title: 'Pengaturan dipulihkan', copy: 'Spark kembali ke pilihan awal yang aman untuk pemula.', tone: 'success' });
  }
</script>

<section class="settings-learn-style-hero">
  <div>
    <span class="spark-eyebrow">{settingsCopy.eyebrow}</span>
    <h1>{settingsCopy.title}</h1>
    <p>{settingsCopy.description}</p>
    <div class="settings-hero-actions">
      <SparkButton href={settingsCopy.primaryCtaHref}>{settingsCopy.primaryCtaLabel}</SparkButton>
      <SparkButton href={settingsCopy.secondaryCtaHref} variant="secondary">{settingsCopy.secondaryCtaLabel}</SparkButton>
    </div>
  </div>

  <aside class="settings-quiet-note">
    <span><SparkIcon name="shield" size={22} /></span>
    <div>
      <strong>Pengaturan yang tenang</strong>
      <small>{settingsCopy.note}</small>
    </div>
  </aside>
</section>

<section class="settings-learning-layout">
  <div class="settings-primary-stack">
    <SparkCard class="settings-section-card">
      <div class="settings-section-head">
        <div>
          <span class="spark-eyebrow">Tampilan</span>
          <h2>Pilih tampilan yang paling nyaman.</h2>
          <p>Mode ini membantu Spark tetap terbaca di layar kecil, ruang terang, atau saat belajar malam.</p>
        </div>
      </div>

      <div class="settings-choice-grid">
        {#each themes as theme}
          <button type="button" class:active={themeState.preference === theme.key} onclick={() => chooseTheme(theme.key)}>
            <span><SparkIcon name={theme.icon} size={19} /></span>
            <strong>{theme.title}</strong>
            <small>{theme.copy}</small>
          </button>
        {/each}
      </div>

      <div class="settings-preview-row">
        <div>
          <strong>Preview layar</strong>
          <small>Gunakan ini hanya untuk mengecek rasa mobile atau desktop saat membangun Spark.</small>
        </div>
        <SparkPreviewToggle />
      </div>
    </SparkCard>

    <SparkCard class="settings-section-card">
      <div class="settings-section-head">
        <div>
          <span class="spark-eyebrow">Cara belajar</span>
          <h2>Sesuaikan ritme belajarmu.</h2>
          <p>Mode ini tidak mengunci jalur. Spark hanya menyesuaikan arahan agar kamu tidak merasa tersesat.</p>
        </div>
      </div>

      <div class="settings-mode-grid">
        {#each learningModes as mode}
          <button type="button" class:active={learningState.experience === mode.key} onclick={() => chooseMode(mode.key)}>
            <span><SparkIcon name={mode.icon} size={18} /></span>
            <div>
              <strong>{mode.title}</strong>
              <small>{mode.copy}</small>
            </div>
          </button>
        {/each}
      </div>
    </SparkCard>
  </div>

  <aside class="settings-side-stack">
    <SparkCard class="settings-section-card compact">
      <span class="spark-eyebrow">Arahan Spark</span>
      <h2>Pesan yang membantu.</h2>
      <p>Atur bantuan kecil yang muncul saat kamu belajar, praktik, atau membuka resource.</p>

      <div class="settings-toggle-list">
        <button type="button" onclick={() => toggleGuidance('guidance')} class:active={guidanceEnabled}>
          <span><SparkIcon name="sparkles" size={17} /></span>
          <div><strong>Saran langkah berikutnya</strong><small>{guidanceEnabled ? 'Aktif' : 'Tidak aktif'}</small></div>
        </button>
        <button type="button" onclick={() => toggleGuidance('reminders')} class:active={remindersEnabled}>
          <span><SparkIcon name="bell" size={17} /></span>
          <div><strong>Pengingat belajar</strong><small>{remindersEnabled ? 'Aktif' : 'Tidak aktif'}</small></div>
        </button>
        <button type="button" onclick={() => toggleGuidance('safety')} class:active={safetyTipsEnabled}>
          <span><SparkIcon name="shield" size={17} /></span>
          <div><strong>Tips keamanan</strong><small>{safetyTipsEnabled ? 'Aktif' : 'Tidak aktif'}</small></div>
        </button>
      </div>
    </SparkCard>

    <SparkCard class="settings-section-card compact">
      <span class="spark-eyebrow">Akun & bantuan</span>
      <h2>Tempat penting.</h2>
      <div class="settings-link-list">
        <a href="/profile"><SparkIcon name="user-round" size={16} /> Profile & Passport</a>
        <a href="/inbox"><SparkIcon name="messages" size={16} /> Pesan dari Spark</a>
        <a href="/studio"><SparkIcon name="clipboard" size={16} /> Spark Studio</a>
        <a href="/core"><SparkIcon name="book-open" size={16} /> Lanjut belajar</a>
      </div>
    </SparkCard>

    <SparkCard class="settings-section-card compact reset-card">
      <span class="spark-eyebrow">Pulihkan</span>
      <h2>Mulai dari pilihan awal.</h2>
      <p>Gunakan ini jika tampilan, cara belajar, atau arahan terasa terlalu ramai.</p>
      <SparkButton variant="secondary" onclick={() => (confirmResetOpen = true)}>Pulihkan pengaturan</SparkButton>
    </SparkCard>
  </aside>
</section>

{#if confirmResetOpen}
  <button class="settings-modal-scrim" type="button" aria-label="Tutup dialog" onclick={() => (confirmResetOpen = false)}></button>
  <section class="settings-confirm-dialog" role="dialog" aria-modal="true" aria-label="Pulihkan pengaturan">
    <span><SparkIcon name="shield" size={22} /></span>
    <h2>Pulihkan pengaturan?</h2>
    <p>Tampilan, cara belajar, dan arahan Spark akan kembali ke pilihan awal yang aman untuk pemula.</p>
    <div>
      <SparkButton variant="ghost" onclick={() => (confirmResetOpen = false)}>Batal</SparkButton>
      <SparkButton onclick={resetPreferences}>Pulihkan</SparkButton>
    </div>
  </section>
{/if}

<style>
  .settings-learn-style-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, .35fr);
    gap: 18px;
    align-items: stretch;
    padding: 30px;
    border: 1px solid var(--spark-line);
    border-radius: 32px;
    background:
      radial-gradient(circle at 82% 20%, rgba(31,117,255,.12), transparent 28%),
      linear-gradient(135deg, rgba(255,255,255,.98), rgba(244,248,255,.95));
    box-shadow: var(--spark-shadow);
  }

  [data-theme='dark'] .settings-learn-style-hero {
    background:
      radial-gradient(circle at 82% 20%, rgba(31,117,255,.18), transparent 28%),
      linear-gradient(135deg, rgba(9,14,48,.96), rgba(7,10,34,.92));
  }

  .settings-learn-style-hero h1 {
    margin: 8px 0 0;
    max-width: 860px;
    color: var(--spark-navy);
    font-size: clamp(36px, 4vw, 64px);
    line-height: .96;
    letter-spacing: -.075em;
    font-weight: 950;
  }

  [data-theme='dark'] .settings-learn-style-hero h1 { color: #fff; }

  .settings-learn-style-hero p {
    max-width: 760px;
    color: var(--spark-muted);
    font-size: 16px;
    line-height: 1.65;
    font-weight: 650;
  }

  .settings-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 20px;
  }

  .settings-quiet-note {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 12px;
    align-content: center;
    padding: 18px;
    border: 1px solid var(--spark-line);
    border-radius: 26px;
    background: var(--spark-card);
  }

  .settings-quiet-note > span,
  .settings-choice-grid button > span,
  .settings-mode-grid button > span,
  .settings-toggle-list button > span {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 17px;
    background: #eff6ff;
    color: var(--spark-blue-strong);
  }

  .settings-quiet-note small {
    display: block;
    margin-top: 4px;
    color: var(--spark-muted);
    line-height: 1.45;
    font-weight: 700;
  }

  .settings-learning-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    gap: 18px;
    margin-top: 18px;
  }

  .settings-primary-stack,
  .settings-side-stack {
    display: grid;
    gap: 18px;
    align-content: start;
  }

  .settings-section-card h2 {
    margin: 8px 0 0;
    color: var(--spark-navy);
    font-size: clamp(26px, 2.2vw, 38px);
    line-height: 1;
    letter-spacing: -.06em;
  }

  [data-theme='dark'] .settings-section-card h2 { color: #fff; }

  .settings-section-card p {
    color: var(--spark-muted);
    line-height: 1.6;
    font-weight: 650;
  }

  .settings-choice-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin-top: 16px;
  }

  .settings-choice-grid button,
  .settings-mode-grid button,
  .settings-toggle-list button {
    text-align: left;
    border: 1px solid var(--spark-line);
    border-radius: 22px;
    background: rgba(248,251,255,.82);
    color: var(--spark-ink);
    padding: 14px;
    box-shadow: 0 10px 24px rgba(5,9,78,.05);
  }

  [data-theme='dark'] .settings-choice-grid button,
  [data-theme='dark'] .settings-mode-grid button,
  [data-theme='dark'] .settings-toggle-list button {
    background: rgba(255,255,255,.055);
  }

  .settings-choice-grid button.active,
  .settings-mode-grid button.active,
  .settings-toggle-list button.active {
    border-color: rgba(31,117,255,.42);
    box-shadow: 0 16px 34px rgba(31,117,255,.12);
  }

  .settings-choice-grid strong,
  .settings-choice-grid small {
    display: block;
  }

  .settings-choice-grid strong {
    margin-top: 12px;
  }

  .settings-choice-grid small,
  .settings-mode-grid small,
  .settings-toggle-list small {
    margin-top: 5px;
    color: var(--spark-muted);
    line-height: 1.45;
    font-weight: 700;
  }

  .settings-preview-row {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    align-items: center;
    margin-top: 14px;
    padding: 14px;
    border: 1px solid var(--spark-line);
    border-radius: 22px;
    background: rgba(239,246,255,.62);
  }

  [data-theme='dark'] .settings-preview-row { background: rgba(255,255,255,.05); }

  .settings-preview-row small {
    display: block;
    margin-top: 4px;
    color: var(--spark-muted);
    font-weight: 700;
  }

  .settings-mode-grid,
  .settings-toggle-list,
  .settings-link-list {
    display: grid;
    gap: 10px;
    margin-top: 16px;
  }

  .settings-mode-grid button,
  .settings-toggle-list button {
    display: grid;
    grid-template-columns: 46px 1fr;
    gap: 12px;
    align-items: center;
  }

  .settings-link-list a {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 46px;
    padding: 0 12px;
    border-radius: 16px;
    background: rgba(248,251,255,.82);
    color: var(--spark-ink);
    font-weight: 850;
  }

  [data-theme='dark'] .settings-link-list a { background: rgba(255,255,255,.06); }

  .reset-card {
    border-color: rgba(255,128,0,.22);
  }

  .settings-modal-scrim {
    position: fixed;
    inset: 0;
    z-index: 88;
    border: 0;
    background: rgba(2,6,23,.46);
  }

  .settings-confirm-dialog {
    position: fixed;
    left: 50%;
    top: 50%;
    z-index: 90;
    width: min(420px, calc(100vw - 28px));
    transform: translate(-50%, -50%);
    padding: 22px;
    border: 1px solid var(--spark-line);
    border-radius: 28px;
    background: #fff;
    box-shadow: 0 30px 80px rgba(5,9,78,.24);
  }

  [data-theme='dark'] .settings-confirm-dialog { background: #07102f; }

  .settings-confirm-dialog > span {
    display: grid;
    place-items: center;
    width: 50px;
    height: 50px;
    border-radius: 19px;
    background: #eff6ff;
    color: var(--spark-blue-strong);
  }

  .settings-confirm-dialog h2 {
    margin: 14px 0 0;
    color: var(--spark-navy);
    font-size: 30px;
    line-height: 1;
    letter-spacing: -.06em;
  }

  [data-theme='dark'] .settings-confirm-dialog h2 { color: #fff; }

  .settings-confirm-dialog p {
    color: var(--spark-muted);
    line-height: 1.55;
  }

  .settings-confirm-dialog div {
    display: flex;
    justify-content: end;
    gap: 8px;
    flex-wrap: wrap;
  }

  @media (max-width: 980px) {
    .settings-learn-style-hero,
    .settings-learning-layout,
    .settings-choice-grid {
      grid-template-columns: 1fr;
    }

    .settings-learn-style-hero {
      padding: 22px 18px;
      border-radius: 26px;
    }

    .settings-learn-style-hero h1 {
      font-size: clamp(34px, 10vw, 46px);
    }

    .settings-preview-row {
      display: grid;
    }
  }
</style>
